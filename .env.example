# --- Chat model ---
# Opción A: OpenAI
OPENAI_API_KEY=sk-...
# Opción B: proveedor compatible con OpenAI (p. ej. OpenCode Go). Descomenta y ajusta:
# LLM_API_KEY=tu_clave
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_MODEL=<id de un modelo de /v1/models>

# --- Embeddings: "openai" (requiere OPENAI_API_KEY) o "local" (gratis, sin API key) ---
EMBEDDINGS_PROVIDER=openai

# --- Pinecone ---
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=rag-workshop
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
